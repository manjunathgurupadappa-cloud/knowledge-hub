# Copy this file to ".env" and edit the values.
# Local development works without a .env file, but production REQUIRES these.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed in production for HTTPS form posts, e.g. https://your-app.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC

# Leave empty to use SQLite locally. In production set a PostgreSQL URL:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=
